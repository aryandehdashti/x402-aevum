# Copy to .env — test wallets only, never real funds.

# Aevum testnet RPC (default) — use http://127.0.0.1:8545 for local anvil
RPC_URL=https://rpc-test.qday.info

# Deployed X402Gate address (from scripts/deploy.mjs)
GATE_ADDRESS=

# tUSD8 on Aevum (default); artifacts/MockUSD8.json for local
TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Server: pays gas to relay settlements (needs a little tQDAY)
RELAYER_KEY=

# Agent: signs payments (needs tUSD8, no gas)
AGENT_KEY=

# Deployer: deploys the gate (needs tQDAY)
DEPLOYER_KEY=

# Server tuning
PORT=4405
PRICE_BASE_UNITS=25000
CHALLENGE_TTL_SECS=600
